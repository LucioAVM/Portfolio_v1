---
interface Props {
  label: string;
  prefix: string;
  accent: string;
  suffix?: string;
  subtitle: string;
}

const { label, prefix, accent, suffix, subtitle } = Astro.props;

function splitWords(text: string): string[] {
  return text.trim().split(/\s+/).filter(Boolean);
}

const prefixWords = splitWords(prefix);
const suffixWords = suffix ? splitWords(suffix) : [];

/* Fade al scroll: por frase (supertítulo / título / subtítulo), no por palabra */
const fadeSupertitle = 0;
const fadeTitle = 1;
const fadeSubtitle = 2;

const heroSymbols = [
  { char: '{', corner: 'tl', posClass: 'hero-sym-tl' },
  { char: '/', corner: 'tr', posClass: 'hero-sym-tr' },
  { char: '#', corner: 'bl', posClass: 'hero-sym-bl' },
  { char: '>', corner: 'br', posClass: 'hero-sym-br' },
] as const;
---

<section id="hero" class="hero-stage">
  <div class="hero-inner-frame" aria-hidden="true">
    <div class="hero-symbol-layer">
      {
        heroSymbols.map((sym) => (
          <span class:list={['hero-symbol-wrap', sym.posClass]}>
            <span data-hero-symbol data-corner={sym.corner} class="hero-symbol-scroll">
              <span class="hero-symbol-float">
                <span class="hero-symbol-3d" data-char={sym.char}>
                  <span class="hero-symbol-face">{sym.char}</span>
                </span>
              </span>
            </span>
          </span>
        ))
      }
    </div>
  </div>

  <div class="hero-content relative z-10 mx-auto flex w-full flex-col items-center">
    <div class="hero-copy">
      <p data-hero-supertitle data-fade-order={fadeSupertitle} class="hero-supertitle motion-enter">{label}</p>

      <h1 class="hero-h1" data-fade-order={fadeTitle}>
        {
          prefixWords.map((word) => (
            <span data-hero-word class="motion-enter">
              {word}
            </span>
          ))
        }
        <span data-hero-word class="motion-enter hero-accent">{accent}</span>
        {
          suffixWords.map((word) => (
            <span data-hero-word class="motion-enter">
              {word}
            </span>
          ))
        }
      </h1>

      <p data-hero-subtitle data-fade-order={fadeSubtitle} class="hero-subtitle motion-enter">
        {subtitle}
      </p>
    </div>

    <div class="hero-scroll-line-slot" aria-hidden="true">
      <div class="hero-scroll-line" data-hero-streak></div>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../lib/motion/hero';
  import { initHeroScroll } from '../lib/motion/hero-scroll';

  const hero = document.getElementById('hero');
  if (hero) initHero(hero);
  initHeroScroll();
</script>
