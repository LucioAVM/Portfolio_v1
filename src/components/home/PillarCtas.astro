---
import type { Locale } from '../../i18n/config';
import { getLocalizedPath } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { splitAccentHeading } from '../../lib/text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pillars = [
  {
    key: 'dev',
    href: getLocalizedPath('projects', locale),
    title: t('category.dev'),
    blurb: t('section.pillars.dev'),
    accent: 'pillar-dev',
  },
  {
    key: 'cyber',
    href: getLocalizedPath('cyber', locale),
    title: t('category.ciberseguridad'),
    blurb: t('section.pillars.cyber'),
    accent: 'pillar-cyber',
  },
  {
    key: 'printing',
    href: getLocalizedPath('printing', locale),
    title: t('category.impresion3d'),
    blurb: t('section.pillars.printing'),
    accent: 'pillar-print',
  },
  {
    key: 'about',
    href: getLocalizedPath('about', locale),
    title: t('nav.about'),
    blurb: t('section.pillars.about'),
    accent: 'pillar-about',
  },
] as const;

const heading = t('section.pillars.title');
const { prefix: headingPrefix, accent: accentWord } = splitAccentHeading(heading);
---

<section class="pillar-ctas panel-section" aria-labelledby="pillar-ctas-heading">
  <p class="section-label">{t('section.pillars')}</p>
  <h2 id="pillar-ctas-heading" class="pillar-ctas-title">
    {headingPrefix && <span>{headingPrefix} </span>}
    <span class="pillar-ctas-accent">{accentWord || heading}</span>
  </h2>

  <div class="pillar-ctas-grid">
    {
      pillars.map((pillar) => (
        <a href={pillar.href} class:list={['pillar-card', pillar.accent]}>
          <span class="pillar-card-title">{pillar.title}</span>
          <span class="pillar-card-blurb">{pillar.blurb}</span>
          <span class="pillar-card-cta">
            {t('section.pillars.cta')} →
          </span>
        </a>
      ))
    }
  </div>
</section>
