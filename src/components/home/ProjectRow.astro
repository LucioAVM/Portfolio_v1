---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { projectDetailPath } from '../../utils/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  index: number;
}

const { project, locale, index } = Astro.props;
const { title, tech, date, media } = project.data;
const href = projectDetailPath(locale, project.data.slug);
const number = String(index + 1).padStart(2, '0');
const year = date.getFullYear();

const cover = media?.cover;
const extras = [
  ...(media?.screenshots ?? []),
  ...(media?.gallery ?? []),
].filter((src) => src !== cover);

/** Capas traseras del stack (máx. 3); sin media = cartas vacías. */
const backLayers = [0, 1, 2].map((i) => extras[i] ?? null);
---

<a href={href} class="project-row group">
  <span class="project-row-num" aria-hidden="true">{number}</span>

  <span class="project-row-main">
    <span class="project-row-title">{title}</span>
    {
      tech.length > 0 && (
        <span class="project-row-tags">
          {tech.map((item) => (
            <span class="project-row-tag">{item}</span>
          ))}
        </span>
      )
    }
  </span>

  <span class="project-row-stack" aria-hidden="true">
    {
      backLayers.map((src, i) => (
        <span class:list={['project-row-card', `project-row-card--back-${i + 1}`]}>
          {src ? (
            <img src={src} alt="" class="project-row-card-img" loading="lazy" decoding="async" />
          ) : null}
        </span>
      ))
    }
    <span class="project-row-card project-row-card--front">
      {
        cover ? (
          <img src={cover} alt="" class="project-row-card-img" loading="lazy" decoding="async" />
        ) : (
          <span class="project-row-card-plus">+</span>
        )
      }
    </span>
  </span>

  <span class="project-row-meta">
    <span class="project-row-year">{year}</span>
    <span class="project-row-arrow" aria-hidden="true">↗</span>
  </span>
</a>
