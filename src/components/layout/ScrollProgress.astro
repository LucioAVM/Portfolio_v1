---
/**
 * Indicador de scroll vertical (derecha): track fino + thumb lima
 * que se desplaza (scrollbar), no progress que se completa.
 */
---

<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress-track">
    <div class="scroll-progress-thumb" data-scroll-progress></div>
  </div>
</div>
