---
import { getLocalizedPath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { getDockItems, searchIcon } from '../../lib/sections';
import ThemeToggle from '../ThemeToggle.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);
const items = getDockItems(locale);
const homeHref = getLocalizedPath('home', locale);
const projectsHref = getLocalizedPath('projects', locale);
const brand = t('site.title');

function normalize(p: string): string {
  if (p.length > 1 && p.endsWith('/')) return p.slice(0, -1);
  return p;
}

function isActive(href: string): boolean {
  const cur = normalize(currentPath);
  const target = normalize(href);
  if (target === normalize(homeHref)) return cur === target;
  return cur === target || cur.startsWith(target + '/');
}
---

<nav class="app-dock" aria-label="Secciones">
  {/* Logo arriba-izquierda (esquina title × dock) */}
  <a href={homeHref} class="app-dock-logo" aria-label={brand}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M5.5 8.5 9 12l-3.5 3.5M12.5 15.5h6"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <ul class="app-dock-list">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['app-dock-link', isActive(item.href) && 'is-active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-tooltip={item.label}
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={item.icon} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="sr-only">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>

  {/* Tema / idioma más abajo, encima del search */}
  <div class="app-dock-utils">
    <ThemeToggle locale={locale} currentPath={currentPath} />
  </div>

  {/* Acceso a proyectos pegado abajo-izquierda (esquina status × dock) */}
  <div class="app-dock-foot">
    <a
      href={projectsHref}
      class="app-dock-search"
      data-tooltip={t('nav.projects')}
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d={searchIcon} stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span class="sr-only">{t('nav.projects')}</span>
    </a>
  </div>
</nav>

<div id="mobile-menu" class="app-mobile-menu" data-open="false" aria-hidden="true">
  <ul class="app-mobile-list">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['app-mobile-link', isActive(item.href) && 'is-active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={item.icon} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="app-mobile-foot">
    <ThemeToggle locale={locale} currentPath={currentPath} />
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.getAttribute('data-open') === 'true';
    const next = !open;
    menu?.setAttribute('data-open', String(next));
    menu?.setAttribute('aria-hidden', String(!next));
    btn.setAttribute('aria-expanded', String(next));
  });
</script>
